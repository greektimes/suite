10 CLS
20 RANDOMIZE TIMER
30 PRINT "THE DIAL-UP LOTTERY"
40 PRINT "*******************"
50 PRINT "GUESS MY MODEM SPEED!"
60 PRINT "300, 1200, 2400 OR 9600"
70 B=INT(RND*4)+1
80 IF B=1 THEN S=300
90 IF B=2 THEN S=1200
100 IF B=3 THEN S=2400
110 IF B=4 THEN S=9600
120 INPUT "YOUR GUESS (BPS)";G
130 PRINT "DIALING..."
140 FOR T=1 TO 5000:NEXT T
150 IF G=S THEN PRINT "CONNECT ";S:GOTO 180
160 PRINT "NO CARRIER!"
170 PRINT "IT WAS ";S;" BPS!"
180 INPUT "TRY AGAIN (Y/N)";A$
190 IF A$="Y" OR A$="y" THEN GOTO 10
200 END
